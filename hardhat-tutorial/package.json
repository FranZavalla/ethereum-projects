{
  "name": "hardhat-tutorial",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "test:coverage": "hardhat test --coverage",
    "test:solidity:coverage": "hardhat test solidity --coverage",
    "test:nodejs:coverage": "hardhat test nodejs --coverage",
    "deploy:localhost": "hardhat ignition deploy ignition/modules/Counter.ts --network localhost",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/Counter.ts --network sepolia",
    "deploy:verify": "hardhat ignition deploy ignition/modules/Counter.ts --network sepolia --verify",
    "localnet": "hardhat node",
    "keystore:sepolia-url": "hardhat keystore set SEPOLIA_RPC_URL",
    "keystore:priv-key": "hardhat keystore set SEPOLIA_PRIVATE_KEY",
    "keystore:etherscan-api-key": "hardhat keystore set ETHERSCAN_API_KEY"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.20.0",
    "typescript": "~6.0.3",
    "viem": "^2.57.7"
  }
}
